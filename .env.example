# Upstream LLM (any OpenAI-compatible API). Pick one:
# Groq (free tier):   https://api.groq.com/openai/v1
# Gemini (free tier): https://generativelanguage.googleapis.com/v1beta/openai
# Ollama (local):     http://localhost:11434/v1
VEIL_UPSTREAM_BASE_URL=https://api.groq.com/openai/v1
VEIL_UPSTREAM_API_KEY=
VEIL_MODEL=llama-3.1-8b-instant

# Detection: regex | presidio | gliner (comma-separated, merged)
VEIL_DETECTORS=regex,presidio
VEIL_SPACY_MODEL=en_core_web_lg
VEIL_GLINER_MODEL=urchade/gliner_multi_pii-v1

# Vault + audit (SQLite file). Generate a key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VEIL_VAULT_KEY=
VEIL_DB_PATH=veil.db
VEIL_POLICY=policy.yaml
